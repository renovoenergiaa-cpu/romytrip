EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_API_URL=https://your-project.supabase.co/rest/v1/
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Provedores de Voos em Tempo Real:
# 1. Duffel API v2 (Cadastro gratuito instantâneo em duffel.com - NDC direto de 300+ companhias)
EXPO_PUBLIC_DUFFEL_ACCESS_TOKEN=your-duffel-token

# 2. SerpApi Google Flights (Busca direta ao vivo do Google Flights em serpapi.com)
EXPO_PUBLIC_SERPAPI_KEY=your-serpapi-key
