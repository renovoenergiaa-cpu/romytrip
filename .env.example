EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_API_URL=https://your-project.supabase.co/rest/v1/
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Provedores de voos (Duffel, SerpApi): NÃO usar EXPO_PUBLIC_* — as chaves vivem só como
# secrets da Edge Function `flight-proxy`:
#   supabase secrets set DUFFEL_ACCESS_TOKEN=... SERPAPI_KEY=...
#   supabase functions deploy flight-proxy
